{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "scanner",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/item_icons/scanner"
        }
      },
      {
        "when": "unscanner",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/item_icons/unscanner"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/copper_ingot"
    }
  }
}
